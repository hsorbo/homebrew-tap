+#if FUSE_USE_VERSION >= 30
+
+static struct fuse_session *mount_fuse(char *parsed_options)
+{
+	struct fuse_session *se = NULL;
+	struct fuse_args args = FUSE_ARGS_INIT(0, NULL);
+
+	if (fuse_opt_add_arg(&args, EXEC_NAME) == -1
+	    || fuse_opt_add_arg(&args, "-o") == -1
+	    || fuse_opt_add_arg(&args, parsed_options) == -1) {
+		ntfs_log_error("Failed to set FUSE options.\n");
+		goto out;
+	}
+	if (ctx->debug && fuse_opt_add_arg(&args, "-odebug") == -1)
+		goto out;
+
+	se = fuse_session_new(&args, &ntfs_3g_ops, sizeof(ntfs_3g_ops), NULL);
+	if (!se)
+		goto out;
+	if (fuse_set_signal_handlers(se))
+		goto err_destroy;
+	if (fuse_session_mount(se, opts.mnt_point))
+		goto err_signals;
+	ctx->fc = se;
+out:
+	fuse_opt_free_args(&args);
+	return se;
+err_signals:
+	fuse_remove_signal_handlers(se);
+err_destroy:
+	fuse_session_destroy(se);
+	se = NULL;
+	goto out;
+}
+
